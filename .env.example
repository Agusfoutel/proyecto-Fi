# Copiá este archivo como .env y ajustá lo que necesites.

# Puerto donde escucha la app (detrás de Caddy/nginx).
PORT=3000

# Si lo completás, para crear una cuenta hace falta este código (recomendado si el servidor es público).
INVITE_CODE=

# Carpeta donde se guarda la base (un solo archivo: fino.db). Hacé backup de esta carpeta.
DATA_DIR=./data

# Avisos de fin de mes: zona horaria y hora (0-23) a la que se mandan.
NOTIFY_TZ=America/Argentina/Buenos_Aires
NOTIFY_HOUR=10

# Contacto para el servicio de notificaciones (cualquier mail tuyo).
VAPID_SUBJECT=mailto:vos@ejemplo.com

# Si la app corre detrás de un proxy con HTTPS, dejalo en 1 (cantidad de proxies).
TRUST_PROXY=1
